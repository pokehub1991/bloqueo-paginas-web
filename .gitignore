# Dependencias
node_modules/
*/node_modules/

# Archivos de compilación
dist/
server/client/dist/

# Base de datos SQLite local (para no sobreescribir datos locales de producción)
server/data/*.sqlite
server/data/*.sqlite-wal
server/data/*.sqlite-shm
!server/data/.gitkeep

# Variables de entorno y secretos
.env
.env.local
.env.*.local

# Archivos del sistema operativo y editores
.DS_Store
Thumbs.db
.vscode/
.idea/

# Logs
*.log
npm-debug.log*
